generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lifetime applause points per anonymous singer — powers the home-page
// leaderboard. Upserted (incrementally) by the realtime service whenever a
// singer takes the Main Seat or receives popper / heart applause.
model SingerScore {
  id           String   @id @default(cuid())
  name         String   @unique
  points       Int      @default(0)
  poppers      Int      @default(0)
  hearts       Int      @default(0)
  performances Int      @default(0)
  state        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
